{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "website",
	"main": "worker/index.ts",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Without this, the asset router answers browser navigations itself: a
		// request carrying Sec-Fetch-Mode: navigate matches no file, so
		// not_found_handling serves index.html and the Worker never runs. That
		// silently breaks every Worker route a user reaches by clicking a link
		// — /dl, /unsubscribe — and strips the pre-rendered <title>/og: tags
		// from real page loads (crawlers, which send no Sec-Fetch headers, still
		// got them, so it looks fine from a curl or an SEO check).
		// The Worker delegates to env.ASSETS.fetch for anything it doesn't
		// handle, so running it first costs a hop and changes nothing else.
		"run_worker_first": true
	},
	"r2_buckets": [
		{
			"binding": "AUDIO",
			"bucket_name": "kaleidoswap-blog-audio"
		},
		{
			"binding": "BETA_RELEASES",
			"bucket_name": "kaleidoswap-beta-releases"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kaleidoswap-website",
			"database_id": "a0d53b77-af58-4478-b936-40cdff6a4c62",
			"migrations_dir": "migrations"
		}
	]
}
